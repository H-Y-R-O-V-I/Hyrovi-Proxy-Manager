#!/usr/bin/env bash
set -euo pipefail
source /etc/hyrovi-hpm-node/node.env

hostname_value=$(hostname -f 2>/dev/null || hostname)
platform_value="$(uname -s) $(uname -m)"
uptime_value=$(awk '{print int($1)}' /proc/uptime)
addresses_json=$(hostname -I 2>/dev/null | tr ' ' '
' | sed '/^$/d' | head -n 8 | jq -Rsc 'split("
") | map(select(length>0))')

container=""
for name in hyrovi-proxy-manager nginx-proxy-manager; do
  if docker inspect "$name" >/dev/null 2>&1; then container="$name"; break; fi
done

nginx_version=""
agent_version="hpm-node-agent/1"
caps='["proxy","certificates","logs"]'
if [ -n "$container" ]; then
  nginx_version=$(docker exec "$container" nginx -v 2>&1 | sed -n 's/^nginx version: //p' | head -1 || true)
  if [ "$container" = "hyrovi-proxy-manager" ]; then
    caps='["proxy","security","certificates","logs","analytics","provisioning"]'
    image=$(docker inspect "$container" --format '{{.Config.Image}}' 2>/dev/null || true)
    [ -n "$image" ] && agent_version="$image"
  else
    image=$(docker inspect "$container" --format '{{.Config.Image}}' 2>/dev/null || true)
    [ -n "$image" ] && agent_version="migration:$image"
  fi
fi

payload=$(jq -nc   --arg hostname "$hostname_value"   --arg platform "$platform_value"   --arg version "$agent_version"   --arg nginxVersion "$nginx_version"   --argjson uptimeSeconds "$uptime_value"   --argjson capabilities "$caps"   --argjson addresses "$addresses_json"   '{hostname:$hostname,platform:$platform,version:$version,nginxVersion:$nginxVersion,uptimeSeconds:$uptimeSeconds,capabilities:$capabilities,addresses:$addresses,appliedRevision:0}')

curl -fsS --max-time 15   -H "Authorization: Bearer $HYROVI_NODE_TOKEN"   -H 'Content-Type: application/json'   --data "$payload"   "$HYROVI_CONTROLLER/agent/nodes/$HYROVI_NODE_ID/heartbeat" >/dev/null
